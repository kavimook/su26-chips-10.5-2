.container-fluid.bg-light.p-4
  .row.text-center
    .col-12
      %h1.text-center= @representative.name

  .row.justify-content-center.mt-4
    .col-md-8
      .card
        .card-body
          .row
            -# Left Column for the Photo
            .col-md-4.text-center
              - if @representative.photo_url.present?
                = image_tag @representative.photo_url, class: "img-fluid shadow rounded", alt: "Photo of #{@representative.name}"
              - else
                .p-4.bg-secondary.text-white.rounded No Photo Available

            -# Right Column for the Details
            .col-md-8
              %h2= @representative.title
              
              %p.mt-3
                %strong Party:
                = @representative.party

              - if @representative.phone.present?
                %p
                  %strong Phone:
                  = @representative.phone

              - if @representative.website.present?
                %p
                  %strong Website:
                  = link_to @representative.website, @representative.website, target: '_blank', rel: 'noopener'

              - if @representative.address.present?
                %p
                  %strong Address:
                  = @representative.address

              - if @representative.birthday.present?
                %p
                  %strong Birthday:
                  = @representative.birthday

              - if @representative.gender.present?
                %p
                  %strong Gender:
                  = @representative.gender

              - if @representative.twitter.present? || @representative.facebook.present?
                %p
                  %strong Social:
                  - if @representative.twitter.present?
                    = link_to "Twitter", "https://twitter.com/#{@representative.twitter}", target: '_blank', rel: 'noopener', class: 'me-2'
                  - if @representative.facebook.present?
                    = link_to "Facebook", "https://facebook.com/#{@representative.facebook}", target: '_blank', rel: 'noopener'

              %p
                %strong OCD ID:
                = @representative.ocdid

  .row.mt-4
    .col-12.text-center
      = link_to 'Back to Search', representatives_path, class: 'btn btn-secondary'