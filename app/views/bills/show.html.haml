%p{style: "color: green"}= notice

.row
  .col-12.col-md-8.offset-md-2
    %h1.text-center= bill_number_label_for_record(@bill)
    %h4.text-center.text-muted= @bill.title

    %dl.row.mt-4
      %dt.col-sm-3 Congress
      %dd.col-sm-9= @bill.congress

      %dt.col-sm-3 Type
      %dd.col-sm-9= @bill.bill_type.upcase

      %dt.col-sm-3 Chamber
      %dd.col-sm-9= @bill.original_chamber.titleize

      %dt.col-sm-3 Summary
      %dd.col-sm-9= @bill.summary.presence || 'No summary available.'

    .text-center.mt-3
      = link_to 'Back to search', bills_path, class: 'btn btn-secondary'