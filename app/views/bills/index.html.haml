%p.text-success= notice

- content_for :title, 'Bills'

%h1 Bills

%section.mb-4
  %h2.h5 Search congress.gov
  = form_with url: bills_path, method: :get do |form|
    .row.g-2.align-items-end
      .col-sm-4
        = form.label :congress, 'Congress session', class: 'form-label'
        = form.number_field :congress, value: @congress, class: 'form-control', placeholder: 'e.g. 119'
      .col-sm-4
        = form.label :bill_type, 'Bill type', class: 'form-label'
        = form.select :bill_type, Bill::TYPES, { include_blank: true, selected: @bill_type }, class: 'form-select'
      .col-sm-4
        = form.submit 'Search', class: 'btn btn-primary'

- if @search_results.present?
  - api_bills = @search_results['bills'] || []
  - total_results = @search_results.dig('pagination', 'count')
  %section.mb-4
    %h2.h5 Search results
    %p.text-muted
      Showing #{api_bills.size} of #{total_results} results
    - if api_bills.any?
      .table-responsive-md
        %table.table.table-striped.table-hover
          %caption Bills returned by congress.gov
          %thead.table-dark
            %tr
              %th{ scope: 'col' } #
              %th{ scope: 'col' } Title
              %th{ scope: 'col' } Congress
              %th{ scope: 'col' } Type
              %th{ scope: 'col' } Chamber
              %th{ scope: 'col' } Last Action
              %th{ scope: 'col' } Save
          %tbody
            - api_bills.each do |api_bill|
              %tr
                %td= bill_number_label(api_bill)
                %td= api_bill['title']
                %td= api_bill['congress']
                %td= api_bill['type']
                %td= api_bill['originChamber']
                %td= bill_last_action(api_bill)
                %td
                  = button_to 'Save', bills_path, params: bill_save_params(api_bill), class: 'btn btn-success'

%h2.h5 Saved bills

#bills
  - @bills.each do |bill|
    = render bill
    %p
      = link_to 'Show this bill', bill

= link_to 'New bill', new_bill_path
